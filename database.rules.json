{
  "rules": {
    "chats": {
      "$chatId": {
        ".read": "auth != null && (data.child('metadata/participants').val().contains(auth.uid) || !data.exists())",
        ".write": "auth != null && (data.child('metadata/participants').val().contains(auth.uid) || !data.exists())",
        "messages": {
          ".indexOn": ["timestamp"]
        }
      }
    }
  }
}
